# Supabase Project Settings > API (public values, safe in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: OpenAI project key. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Server/seed only: required only for npm run seed. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=
