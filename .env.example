# Supabase Project Settings > API (public values, safe in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional browser-visible Maps Embed key. Restrict to Maps Embed API and exact
# website referrers for authorized local/production origins. See docs/PHASE_2_SETUP.md.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# Server only: OpenAI project key with Responses create/write permission.
# The app calls POST /v1/responses. Never prefix this secret with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Actual model override (OPENAI_VISION_MODEL from the blueprint is not read).
OPENAI_MODEL=gpt-4.1-mini
# Server/seed only: required only for npm run seed. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional seed command: UUID of an existing account you control (not a secret).
SEED_SELLER_ID=
# Optional: independent Flappy Degree game deployment/page URL (HTTPS only).
# Public build-time configuration; leave empty to hide the buyer pickup card.
# Never include secrets, user details, pickup codes or reservation/session data.
NEXT_PUBLIC_FLAPPY_DEGREE_URL=
